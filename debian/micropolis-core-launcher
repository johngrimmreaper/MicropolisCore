#!/usr/bin/python3
"""Run the packaged Micropolis Core web application on loopback HTTP."""

import argparse
import os
import subprocess
import sys
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.error import URLError
from urllib.parse import urlsplit
from urllib.request import Request, urlopen

APP_PATH = "/MicropolisCore"
DEFAULT_PORT = 48080
DEFAULT_WEB_ROOT = "/usr/share/micropolis-core/web"
SERVER_MARKER = "micropolis-core-debian-launcher/1"


class MicropolisHandler(SimpleHTTPRequestHandler):
    extensions_map = {
        **SimpleHTTPRequestHandler.extensions_map,
        ".css": "text/css",
        ".js": "text/javascript",
        ".mjs": "text/javascript",
        ".json": "application/json",
        ".wasm": "application/wasm",
    }

    def end_headers(self):
        self.send_header("X-Micropolis-Launcher", SERVER_MARKER)
        self.send_header("X-Content-Type-Options", "nosniff")
        super().end_headers()

    def _path_allowed(self):
        path = urlsplit(self.path).path
        return path == "/" or path == APP_PATH or path.startswith(APP_PATH + "/")

    def _redirect_root(self):
        if urlsplit(self.path).path != "/":
            return False
        self.send_response(302)
        self.send_header("Location", APP_PATH + "/")
        self.send_header("Content-Length", "0")
        self.end_headers()
        return True

    def do_GET(self):
        if self._redirect_root():
            return
        if not self._path_allowed():
            self.send_error(404)
            return
        super().do_GET()

    def do_HEAD(self):
        if self._redirect_root():
            return
        if not self._path_allowed():
            self.send_error(404)
            return
        super().do_HEAD()


class LoopbackServer(ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True


def micropolis_url(port):
    return f"http://127.0.0.1:{port}{APP_PATH}/"


def existing_server(port):
    request = Request(micropolis_url(port), method="HEAD")
    try:
        with urlopen(request, timeout=0.35) as response:
            return response.headers.get("X-Micropolis-Launcher") == SERVER_MARKER
    except (OSError, URLError):
        return False


def open_browser(url):
    try:
        subprocess.Popen(
            ["xdg-open", url],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        print(f"micropolis-core: unable to start xdg-open: {exc}", file=sys.stderr)
        return False
    return True


def parse_args():
    parser = argparse.ArgumentParser(
        description="serve the packaged Micropolis Core application on loopback HTTP"
    )
    parser.add_argument(
        "--no-browser",
        action="store_true",
        help="serve Micropolis Core without opening the default browser",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=DEFAULT_PORT,
        metavar="PORT",
        help=f"loopback TCP port (default: {DEFAULT_PORT}; use 0 for an ephemeral port)",
    )
    parser.add_argument(
        "--write-port",
        metavar="FILE",
        help=argparse.SUPPRESS,
    )
    args = parser.parse_args()
    if not 0 <= args.port <= 65535:
        parser.error("PORT must be between 0 and 65535")
    return args


def main():
    args = parse_args()
    web_root = Path(os.environ.get("MICROPOLIS_CORE_WEB_ROOT", DEFAULT_WEB_ROOT)).resolve()
    app_root = web_root / APP_PATH.lstrip("/")

    required = (app_root / "index.html", app_root / "micropolisengine.wasm")
    missing = [str(path) for path in required if not path.is_file() or path.stat().st_size == 0]
    if missing:
        print("micropolis-core: packaged web application is incomplete:", file=sys.stderr)
        for path in missing:
            print(f"  {path}", file=sys.stderr)
        return 1

    if args.port != 0 and existing_server(args.port):
        url = micropolis_url(args.port)
        print(url)
        if not args.no_browser:
            open_browser(url)
        return 0

    handler = lambda *handler_args, **handler_kwargs: MicropolisHandler(
        *handler_args, directory=str(web_root), **handler_kwargs
    )

    try:
        server = LoopbackServer(("127.0.0.1", args.port), handler)
    except OSError as exc:
        print(
            f"micropolis-core: cannot bind 127.0.0.1:{args.port}: {exc}\n"
            "Choose another port with --port. Note that browser-stored game data "
            "is scoped to the selected port.",
            file=sys.stderr,
        )
        return 1

    port = server.server_address[1]
    url = micropolis_url(port)
    if args.write_port:
        Path(args.write_port).write_text(f"{port}\n", encoding="ascii")

    print(url, flush=True)
    if not args.no_browser:
        open_browser(url)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
